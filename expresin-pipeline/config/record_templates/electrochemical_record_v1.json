{
  "record_id": "electrochemical_record_v1",
  "experiment_type": "electrochemical",
  "version": "1.0",
  "title": "ELECTROCHEMICAL EXPERIMENT 实验记录表",
  "subtitle": "Electrochemical experiment record · 按导师模板 B 区设计（详见 docs/record-template-design.md）",
  "sheet_name": "Record",
  "info_section": {
    "fields": [
      { "label": "实验编号 (Experiment ID)", "example": "RES-20260929-003" },
      { "label": "实验日期 (Date)", "example": "2026-09-29" },
      { "label": "实验员 (Researcher)", "example": "Li Wei" },
      { "label": "电化学技术 (Technique)", "example": "Electrosorption" },
      { "label": "工作电极 (Working electrode)", "example": "Activated carbon electrode" },
      { "label": "参比电极 (Reference electrode)", "example": "Ag/AgCl" },
      { "label": "对电极 (Counter electrode)", "example": "Pt mesh" },
      { "label": "电解液 (Electrolyte)", "example": "NaCl 500 mg/L" },
      { "label": "目标离子 (Target)", "example": "Cl" },
      { "label": "初始浓度 (mg/L)", "example": "100" },
      { "label": "温度 (degC)", "example": "25" },
      { "label": "电解池配置 (Cell configuration)", "example": "Single cell, 2 cm spacing" },
      { "label": "备注 / 检测仪器", "example": "IC (Dionex Aquion)" }
    ]
  },
  "block_template": {
    "title": "【离子名】测量数据"
  },
  "data_columns": [
    { "key": "time", "header": "Time (s)", "unit": "s", "target_field": "contact_time" },
    { "key": "potential", "header": "Potential (V)", "unit": "V", "target_field": "potential_v" },
    { "key": "current", "header": "Current (A)", "unit": "A", "target_field": "current_a" },
    { "key": "concentration", "header": "Concentration (mg/L)", "unit": "mg/L", "target_field": "concentration_mg_l" },
    { "key": "ph", "header": "pH", "unit": "pH", "target_field": "ph" }
  ],
  "fill_rules": [
    "1) 把数据块标题中的【离子名】替换为实际目标离子（如 SO4、Cl、Na）。",
    "2) 数据从表头下方第一行开始连续填写，不要留空行；未测量的点留空（不要写 NA/ND）。",
    "3) 多离子实验：复制整个数据块（标题行 + 表头行 + 数据行），每离子一块，块间保留 3 行空行。",
    "4) 实验信息区每行只写在最左侧一格内，不要拆到多列。",
    "5) 时间单位为秒 (s)；只记录原始测量值；电流密度、电荷量等由系统自动计算。"
  ],
  "example": {
    "info_values": [
      "RES-20260929-003",
      "2026-09-29",
      "Li Wei",
      "Electrosorption",
      "Activated carbon electrode",
      "Ag/AgCl",
      "Pt mesh",
      "NaCl 500 mg/L",
      "Cl",
      "100",
      "25",
      "Single cell, 2 cm spacing",
      "IC (Dionex Aquion)"
    ],
    "blocks": [
      {
        "title": "Cl 测量数据",
        "rows": [
