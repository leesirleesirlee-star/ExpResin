# DeepSeek API 配置（复制为 .env 后填写，切勿提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型路由：复杂任务（Schema Mapping / 校验）与简单任务（抽取 / 追问）
DEEPSEEK_MODEL_PRO=
DEEPSEEK_MODEL_FLASH=

# 可选：请求超时（秒）与最大重试
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------- NAS 汇总
# 归档成功后把原始文件 + 规范文档发布到 NAS（失败不影响归档，可在档案详情页重发）。
#
# 模式一：local（默认）—— 写入本地/已映射目录。
#   过渡用法：NAS 未配好时保持默认；或把 NAS_ROOT 指向映射盘 / UNC 路径
#   （如 Z:/expresin 或 \\\\192.168.x.x\\share\\expresin，需进程账号有写权限）。
NAS_MODE=local
NAS_ROOT=
#
# 模式二：smb —— smbprotocol 直连（pip install smbprotocol），不依赖系统映射。
# NAS_MODE=smb
# NAS_SMB_SERVER=192.168.x.x
# NAS_SMB_SHARE=expresin
# NAS_SMB_USERNAME=
# NAS_SMB_PASSWORD=
# NAS_SMB_PORT=445
# NAS_SMB_PATH_PREFIX=